---
import { getCollection } from 'astro:content';
import { CATEGORY_MAP, SITE } from '../../site.config.mjs';

const { currentSlug, shareTitle, shareUrl } = Astro.props;

const allPosts = (await getCollection('posts')).sort((a, b) => b.data.date - a.data.date);
const recent = allPosts.filter((p) => p.slug !== currentSlug).slice(0, 6);

const waHref = shareUrl ? `https://wa.me/?text=${encodeURIComponent((shareTitle ?? '') + ' — ' + shareUrl)}` : null;
const fbHref = shareUrl ? `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}` : null;
const twHref = shareUrl ? `https://twitter.com/intent/tweet?text=${encodeURIComponent(shareTitle ?? '')}&url=${encodeURIComponent(shareUrl)}` : null;
---
<aside class="sidebar">
  <form class="side-search" action="/search/" method="get">
    <input type="text" name="q" placeholder="Search shayari..." aria-label="Search shayari" />
    <button type="submit" aria-label="Search">🔍</button>
  </form>

  {shareUrl && (
    <div class="side-block">
      <h4>Share</h4>
      <div class="side-share">
        <a class="side-share-btn wa" href={waHref} target="_blank" rel="noopener">💬 WhatsApp</a>
        <a class="side-share-btn fb" href={fbHref} target="_blank" rel="noopener">📘 Facebook</a>
        <a class="side-share-btn tw" href={twHref} target="_blank" rel="noopener">✖ Twitter</a>
      </div>
    </div>
  )}

  <div class="side-block">
    <h4>Recent Shayari</h4>
    <ul class="side-recent">
      {recent.map((p) => {
        const cat = CATEGORY_MAP[p.data.category];
        const href = `/${p.data.category}/${p.slug.split('/').pop()}/`;
        return (
          <li>
            <a href={href}>
              <img src={p.data.image} alt={p.data.title} width="60" height="75" loading="lazy" />
              <span>
                <strong class={p.data.lang}>{p.data.title}</strong>
                <em>{cat.emoji} {p.data.lang === 'hi' ? cat.nameHi : cat.nameEn}</em>
              </span>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</aside>

<style>
  .sidebar { display: flex; flex-direction: column; gap: 24px; }
  .side-search { display: flex; border: 1px solid var(--line); border-radius: 10px; overflow: hidden; background: var(--paper-alt); }
  .side-search input { flex: 1; border: none; background: transparent; padding: 12px 14px; color: var(--ink); font-size: 0.92rem; font-family: var(--font-ui); }
  .side-search input:focus { outline: none; }
  .side-search button { border: none; background: var(--brand); color: #fff; padding: 0 16px; cursor: pointer; font-size: 1rem; }

  .side-block { border: 1px solid var(--line); border-radius: var(--radius); padding: 18px; background: var(--card-bg); }
  .side-block h4 { margin: 0 0 14px; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-soft); }

  .side-share { display: flex; flex-direction: column; gap: 8px; }
  .side-share-btn { display: block; padding: 10px 14px; border-radius: 8px; font-weight: 700; font-size: 0.88rem; color: #fff; }
  .side-share-btn.wa { background: #25d366; }
  .side-share-btn.fb { background: #1877f2; }
  .side-share-btn.tw { background: #14171a; }

  .side-recent { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .side-recent li a { display: flex; gap: 10px; align-items: center; }
  .side-recent img { width: 52px; height: 65px; object-fit: cover; border-radius: 8px; flex: none; }
  .side-recent span { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .side-recent strong { font-size: 0.86rem; font-weight: 600; line-height: 1.3; color: var(--ink); overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  .side-recent strong.hi { font-family: var(--font-hi); }
  .side-recent em { font-size: 0.74rem; color: var(--ink-soft); font-style: normal; }
</style>
