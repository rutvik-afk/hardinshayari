---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { CATEGORY_MAP, SITE } from '../../../site.config.mjs';

const allPosts = (await getCollection('posts')).sort((a, b) => b.data.date - a.data.date);
const index = allPosts.map((p) => {
  const cat = CATEGORY_MAP[p.data.category];
  return {
    title: p.data.title,
    href: `/${p.data.category}/${p.slug.split('/').pop()}/`,
    image: p.data.image,
    lang: p.data.lang,
    cat: p.data.lang === 'hi' ? cat.nameHi : cat.nameEn,
    emoji: cat.emoji,
    text: `${p.data.title} ${p.data.lines.join(' ')} ${p.data.tags.join(' ')}`.toLowerCase(),
  };
});
---
<Base title="Search Shayari" description="Search Hindi and English shayari on Har Din Shayari.">
  <div class="wrap-narrow post-page">
    <div class="breadcrumb"><a href="/">Home</a> / Search</div>
    <h1>Search Shayari</h1>
    <form class="search-form" id="search-form">
      <input type="text" id="search-input" placeholder="Type a word... e.g. attitude, sad, dosti" autofocus />
    </form>
    <p id="search-count" class="search-count"></p>
    <div id="search-results" class="search-results"></div>
  </div>
</Base>

<script type="application/json" id="search-data" set:html={JSON.stringify(index)} />
<script>
  const data = JSON.parse(document.getElementById('search-data').textContent);
  const input = document.getElementById('search-input');
  const results = document.getElementById('search-results');
  const count = document.getElementById('search-count');

  function render(query) {
    const q = query.trim().toLowerCase();
    if (!q) { results.innerHTML = ''; count.textContent = ''; return; }
    const hits = data.filter((d) => d.text.includes(q)).slice(0, 30);
    count.textContent = `${hits.length} result${hits.length === 1 ? '' : 's'} for "${query}"`;
    results.innerHTML = hits.map((h) => `
      <a class="search-hit" href="${h.href}">
        <img src="${h.image}" alt="" width="60" height="75" loading="lazy" />
        <span>
          <strong class="${h.lang}">${h.title}</strong>
          <em>${h.emoji} ${h.cat}</em>
        </span>
      </a>
    `).join('') || '<p class="no-results">No shayari found. Try another word.</p>';
  }

  const params = new URLSearchParams(location.search);
  const initial = params.get('q') || '';
  input.value = initial;
  render(initial);

  input.addEventListener('input', () => {
    render(input.value);
    const url = new URL(location.href);
    if (input.value) url.searchParams.set('q', input.value); else url.searchParams.delete('q');
    history.replaceState(null, '', url);
  });
  document.getElementById('search-form').addEventListener('submit', (e) => e.preventDefault());
</script>

<style>
  .search-form { margin: 20px 0 8px; }
  #search-input {
    width: 100%; padding: 14px 18px; font-size: 1.05rem; border-radius: 12px;
    border: 1px solid var(--line); background: var(--paper-alt); color: var(--ink); font-family: var(--font-ui);
  }
  #search-input:focus { outline: 2px solid var(--brand); outline-offset: 1px; }
  .search-count { color: var(--ink-soft); font-size: 0.88rem; margin: 0 0 20px; }
  .search-results { display: flex; flex-direction: column; gap: 10px; }
  .search-hit { display: flex; gap: 14px; align-items: center; padding: 10px; border: 1px solid var(--line); border-radius: 12px; background: var(--card-bg); }
  .search-hit:hover { border-color: var(--brand); }
  .search-hit img { width: 52px; height: 65px; object-fit: cover; border-radius: 8px; flex: none; }
  .search-hit strong { display: block; font-size: 0.98rem; color: var(--ink); }
  .search-hit strong.hi { font-family: var(--font-hi); }
  .search-hit em { font-size: 0.8rem; color: var(--ink-soft); font-style: normal; }
  .no-results { color: var(--ink-soft); padding: 20px 0; }
</style>
