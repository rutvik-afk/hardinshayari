---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PostCard from '../../../components/PostCard.astro';
import { CATEGORY_MAP, SITE } from '../../../../site.config.mjs';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => {
    const [category, slug] = post.slug.split('/');
    return { params: { category, slug }, props: { post } };
  });
}

const { post } = Astro.props;
const { Content } = await render(post);
const cat = CATEGORY_MAP[post.data.category];
const allPosts = await getCollection('posts');
const related = allPosts
  .filter((p) => p.data.category === post.data.category && p.slug !== post.slug && p.data.lang === post.data.lang)
  .sort((a, b) => b.data.date - a.data.date)
  .slice(0, 4);

/* Hindi posts are titled in Devanagari, but the keywords people actually type
   into Google (per our search-volume data) are in Latin script — "attitude
   shayari", not "अटैटीयूड शायरी". Category pages already lead with the Latin
   phrase; individual posts didn't, so they were losing exact-match relevance
   for the very terms they were written for. Compose a bilingual title/H1/meta
   at render time so every post (past and future) gets this without having to
   rewrite 85 markdown files by hand. */
const titleCase = (s) => s.replace(/\b\w/g, (c) => c.toUpperCase());
const keywordTitle = titleCase(post.data.keyword);
const seoTitle = post.data.lang === 'hi' ? `${keywordTitle} – ${post.data.title}` : post.data.title;
const seoDescription = post.data.lang === 'hi' && !post.data.metaDescription.toLowerCase().includes(post.data.keyword.toLowerCase())
  ? `${keywordTitle}: ${post.data.metaDescription}`
  : post.data.metaDescription;

const postHref = new URL(`/${post.data.category}/${post.slug.split('/').pop()}/`, SITE.url).toString();
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    headline: seoTitle,
    description: seoDescription,
    image: new URL(post.data.image, SITE.url).toString(),
    datePublished: post.data.date.toISOString(),
    author: { '@type': 'Organization', name: SITE.name },
    inLanguage: post.data.lang === 'hi' ? 'hi' : 'en',
    keywords: post.data.tags.join(', '),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: cat.nameEn, item: new URL(`/${post.data.category}/`, SITE.url).toString() },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: postHref },
    ],
  },
];
---
<Base
  title={seoTitle}
  description={seoDescription}
  image={post.data.image}
  lang={post.data.lang}
  jsonLd={jsonLd}
>
  <div class="container post-page">
    <div class="breadcrumb">
      <a href="/">Home</a> / <a href={`/${post.data.category}/`}>{cat.nameEn}</a>
    </div>
    <h1 class={post.data.lang}>
      {post.data.lang === 'hi' && <span class="h1-en">{keywordTitle}</span>}
      {post.data.title}
    </h1>
    <div class="meta-row">
      <span>{cat.emoji} {post.data.lang === 'hi' ? cat.nameHi : cat.nameEn}</span>
      <span>{post.data.date.toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
    </div>

    <figure class="post-figure">
      <img src={post.data.image} alt={seoTitle} width="1080" height="1350" />
    </figure>
    <div class="actions">
      <a class="btn btn-primary" href={post.data.image} download>⬇ Download HD Photo</a>
      <a class="btn btn-outline" href={`https://wa.me/?text=${encodeURIComponent(post.data.lines.join(' / ') + ' — ' + SITE.url + '/' + post.data.category + '/' + post.slug.split('/').pop() + '/')}`} target="_blank" rel="noopener">Share on WhatsApp</a>
    </div>

    <div class={`shayari-text ${post.data.lang}`}>
      {post.data.lines.map((l) => <p>{l}</p>)}
    </div>

    <div class="prose">
      <Content />
    </div>

    <div class="tags">
      {post.data.tags.map((t) => <a href={`/${post.data.category}/`}>#{t}</a>)}
    </div>

    {related.length > 0 && (
      <>
        <div class="section-title"><h2>More {cat.nameEn}</h2></div>
        <div class="grid">
          {related.map((p) => <PostCard post={p} />)}
        </div>
      </>
    )}
  </div>
</Base>
