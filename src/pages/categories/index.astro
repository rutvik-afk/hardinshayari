---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { CATEGORIES } from '../../../site.config.mjs';

const posts = await getCollection('posts');
const counts = {};
for (const p of posts) counts[p.data.category] = (counts[p.data.category] || 0) + 1;
---
<Base title="All Categories" description="Browse every Hindi and English shayari category on Har Din Shayari.">
  <div class="container post-page">
    <h1>All Categories</h1>
    <div class="category-grid" style="margin-top:24px;">
      {CATEGORIES.map((c) => (
        <a class="category-tile" href={`/${c.id}/`} style={`background:linear-gradient(135deg, ${c.color}, #1a1523)`}>
          <span class="emoji">{c.emoji}</span>
          <span>{c.nameEn} <span style="font-weight:400; opacity:0.8;">({counts[c.id] || 0})</span></span>
        </a>
      ))}
    </div>
  </div>
</Base>
