---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { CATEGORIES, SITE } from '../../site.config.mjs';

const allPosts = (await getCollection('posts')).sort((a, b) => b.data.date - a.data.date);
const latest = allPosts.slice(0, 20);

const catThumb = {};
for (const c of CATEGORIES) {
  const p = allPosts.find((p) => p.data.category === c.id);
  if (p) catThumb[c.id] = p.data.image;
}
const catCount = {};
for (const p of allPosts) catCount[p.data.category] = (catCount[p.data.category] || 0) + 1;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${SITE.url}/search/?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

---
<Base title={null} description={SITE.description} jsonLd={jsonLd}>
  <div class="container">
    <div class="page-intro">
      <h1 class="tag-hi">हर दिन, हर एहसास</h1>
      <p>{SITE.description}</p>
    </div>

    <div class="section-title">
      <h2>Latest Shayari</h2>
      <a href="/categories/">Browse all categories →</a>
    </div>
    <div class="grid">
      {latest.map((post) => <PostCard post={post} />)}
    </div>

    <div class="section-title">
      <h2>Explore by Category</h2>
    </div>
    <div class="category-grid">
      {CATEGORIES.map((c) => (
        <a class="category-tile" href={`/${c.id}/`} style={catThumb[c.id] ? `background-image:linear-gradient(180deg, rgba(0,0,0,0.15), rgba(0,0,0,0.75)), url(${catThumb[c.id]})` : `background:linear-gradient(135deg, ${c.color}, #1a1523)`}>
          <span class="emoji">{c.emoji}</span>
          <span>{c.nameEn}</span>
          <span class="count">{catCount[c.id] || 0} shayari</span>
        </a>
      ))}
    </div>
  </div>
</Base>

<style>
  .page-intro { padding: 32px 0 8px; }
  .page-intro .tag-hi { font-family: var(--font-hi); font-size: clamp(1.5rem, 3vw, 1.9rem); font-weight: 700; color: var(--brand); margin: 0 0 10px; }
  .page-intro p { color: var(--ink-soft); font-size: 1.02rem; max-width: 640px; margin: 0; }

  .category-tile { background-size: cover; background-position: center; position: relative; }
  .category-tile .count { font-weight: 500; font-size: 0.78rem; opacity: 0.85; }
</style>
