---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { CATEGORIES, SITE } from '../../site.config.mjs';

const allPosts = (await getCollection('posts')).sort((a, b) => b.data.date - a.data.date);
const latest = allPosts.slice(0, 20);

const catThumb = {};
for (const c of CATEGORIES) {
  const p = allPosts.find((p) => p.data.category === c.id);
  if (p) catThumb[c.id] = p.data.image;
}
const catCount = {};
for (const p of allPosts) catCount[p.data.category] = (catCount[p.data.category] || 0) + 1;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${SITE.url}/search/?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

const stackIds = ['attitude-shayari/attitude-shayari', 'sad-shayari/sad-shayari-in-english', 'love-shayari/ishq-shayari'];
const stack = stackIds.map((id) => allPosts.find((p) => p.slug === id)).filter(Boolean);
---
<Base title={null} description={SITE.description} jsonLd={jsonLd}>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-text">
        <div class="tag-hi">हर दिन, हर एहसास</div>
        <h1>Best Hindi &amp; English Shayari</h1>
        <p>{SITE.description}</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="/hindi/">हिंदी शायरी पढ़ें</a>
          <a class="btn btn-outline" href="/english/">Read English Shayari</a>
        </div>
      </div>
      <div class="hero-stack">
        {stack.map((post, i) => (
          <a class={`stack-card stack-${i}`} href={`/${post.data.category}/${post.slug.split('/').pop()}/`}>
            <img src={post.data.image} alt={post.data.title} width="300" height="375" loading="eager" />
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="container">
    <div class="section-title">
      <h2>Latest Shayari</h2>
      <a href="/categories/">Browse all categories →</a>
    </div>
    <div class="grid">
      {latest.map((post) => <PostCard post={post} />)}
    </div>

    <div class="section-title">
      <h2>Explore by Category</h2>
    </div>
    <div class="category-grid">
      {CATEGORIES.map((c) => (
        <a class="category-tile" href={`/${c.id}/`} style={catThumb[c.id] ? `background-image:linear-gradient(180deg, rgba(0,0,0,0.15), rgba(0,0,0,0.75)), url(${catThumb[c.id]})` : `background:linear-gradient(135deg, ${c.color}, #1a1523)`}>
          <span class="emoji">{c.emoji}</span>
          <span>{c.nameEn}</span>
          <span class="count">{catCount[c.id] || 0} shayari</span>
        </a>
      ))}
    </div>
  </div>
</Base>

<style>
  .hero-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 40px; align-items: center; text-align: left; }
  .hero-text .tag-hi { font-family: var(--font-hi); font-size: 1.3rem; color: var(--brand); margin-bottom: 6px; }
  .hero-text h1 { font-family: var(--font-en); font-size: clamp(2rem, 4vw, 3rem); margin: 0 0 14px; letter-spacing: -0.01em; line-height: 1.15; }
  .hero-text p { color: var(--ink-soft); font-size: 1.08rem; max-width: 480px; margin: 0 0 26px; }
  .hero-cta { display: flex; gap: 12px; flex-wrap: wrap; }

  .hero-stack { position: relative; height: 380px; }
  .stack-card {
    position: absolute; width: 220px; border-radius: 14px; overflow: hidden;
    box-shadow: 0 20px 40px -14px rgba(0,0,0,0.5); border: 3px solid var(--paper);
    transition: transform .2s ease;
  }
  .stack-card img { width: 100%; display: block; aspect-ratio: 4/5; object-fit: cover; }
  .stack-0 { top: 0; left: 90px; transform: rotate(-6deg); z-index: 3; }
  .stack-1 { top: 40px; left: 0; transform: rotate(8deg); z-index: 2; }
  .stack-2 { top: 60px; left: 190px; transform: rotate(4deg); z-index: 1; }
  .stack-card:hover { transform: rotate(0deg) scale(1.04); z-index: 4; }

  .category-tile { background-size: cover; background-position: center; position: relative; }
  .category-tile .count { font-weight: 500; font-size: 0.78rem; opacity: 0.85; }

  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; text-align: center; }
    .hero-text p { margin-inline: auto; }
    .hero-cta { justify-content: center; }
    .hero-stack { height: 300px; margin: 0 auto; max-width: 360px; }
    .stack-card { width: 170px; }
    .stack-0 { left: 70px; }
    .stack-2 { left: 140px; }
  }
</style>
