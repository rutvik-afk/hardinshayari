---
import Base from '../layouts/Base.astro';
import { SITE } from '../../site.config.mjs';
---
<Base
  title="Privacy Policy"
  description="Privacy Policy for Har Din Shayari — hardinshayari.com"
>
  <div class="wrap-narrow post-page prose-page">
    <div class="breadcrumb"><a href="/">Home</a> / Privacy Policy</div>
    <h1>Privacy Policy</h1>
    <p class="lead">Last updated: August 2026</p>

    <p>
      {SITE.name} ({SITE.url}) ("we", "us", "our") respects your privacy. This page explains what
      information is collected when you visit this website and how it is used.
    </p>

    <h2>Information We Collect</h2>
    <p>
      We do not require account creation or login to read or download shayari. If you contact us by
      email, we receive whatever information you choose to share (your email address and message content).
    </p>

    <h2>Cookies &amp; Analytics</h2>
    <p>
      Like most websites, we may use standard analytics tools and, in the future, advertising services
      (such as Google AdSense) to keep this site free. These services may use cookies or similar
      technology to understand site usage and show relevant ads. You can disable cookies in your browser
      settings at any time.
    </p>

    <h2>Third-Party Links</h2>
    <p>
      Our pages may link to third-party sites (like WhatsApp or Instagram, for sharing). We are not
      responsible for the privacy practices of those external sites.
    </p>

    <h2>Children's Privacy</h2>
    <p>This site does not knowingly collect personal information from children.</p>

    <h2>Changes to This Policy</h2>
    <p>We may update this Privacy Policy from time to time. Changes will be posted on this page.</p>

    <h2>Contact</h2>
    <p>Questions about this policy? Reach us via the <a href="/contact/">Contact page</a>.</p>
  </div>
</Base>

<style>
  .prose-page h2 { font-size: 1.2rem; margin: 30px 0 10px; }
  .prose-page p { color: var(--ink-soft); line-height: 1.85; margin: 0 0 14px; }
  .prose-page .lead { font-size: 0.9rem; color: var(--ink-soft); font-style: italic; }
  .prose-page a { color: var(--brand); font-weight: 600; }
</style>
